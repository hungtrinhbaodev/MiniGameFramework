{
	"version": "0.2.0",
	"configurations": [
		
		{
			"name": "Run MiniGameFramework",
			"type": "cppvsdbg",
			"request": "launch",
			"program": "${workspaceFolder}/build/MiniGameFramework.exe",
			"args": [],
			"stopAtEntry": false,
			"cwd": "${workspaceFolder}",
			"environment": [
				{
                    "name": "ASAN_OPTIONS",
                    "value": "halt_on_error=1" // Buộc ASan dừng lại ngay khi có lỗi bộ nhớ
                }
			],
			"console": "integratedTerminal",
			"preLaunchTask": "CMake Build"
		}
	]
}
